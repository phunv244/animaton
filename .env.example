# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Loaded by start_automaton.ps1 / open_dashboard.ps1.
# Running node directly: node --env-file=.env dist/index.js --run

# --- Automaton runtime ---
# 1 = use local engine (Antigravity bridge): skip Conway registration, topup and credit checks
AUTOMATON_LOCAL_MODE=1
# OpenAI-compatible endpoint = the bridge
OPENAI_BASE_URL=http://127.0.0.1:8888/v1
# Any non-empty value; the bridge does not check it
OPENAI_API_KEY=sk-local
# Must be greater than AGY_TIMEOUT (in ms), otherwise the runtime retries while agy is still working
INFERENCE_TIMEOUT_MS=180000
# Optional: real Conway key (leave empty in local mode)
CONWAY_API_KEY=
# Optional: Anthropic key
ANTHROPIC_API_KEY=

# --- Web search tool ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# --- Antigravity bridge ---
BRIDGE_PORT=8888
# Path to agy; empty = find "agy" on PATH
AGY_EXE=C:\Users\<you>\AppData\Local\agy\bin\agy.exe
AGY_DEFAULT_MODEL=gemini-3.8-flash-high
AGY_CLAUDE_MODEL=claude-sonnet-4-6
AGY_PRO_MODEL=gemini-3.1-pro-high
# Seconds per agy call
AGY_TIMEOUT=170
# Empty dir agy runs in; empty = new temp dir per bridge start
AGY_WORKDIR=
# 1 = pass --dangerously-skip-permissions to agy (lets agy run its OWN tools, bypassing Automaton's policy engine). Keep 0.
AGY_SKIP_PERMISSIONS=0
